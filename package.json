{
  "name": "comrade-candidate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node tools/build-external-runtime-staging.js && node tools/optimize-external-runtime-assets.mjs && node tools/build-runtime-asset-manifest.mjs",
    "dev": "node tools/dev-server.mjs",
    "server:start": "node tools/server-control.mjs start",
    "server:status": "node tools/server-control.mjs status",
    "server:stop": "node tools/server-control.mjs stop",
    "server:restart": "node tools/server-control.mjs restart",
    "server:https:start": "HTTPS=1 PORT=5174 TLS_CERT=target/server/ip-cert.pem TLS_KEY=target/server/ip-key.pem node tools/server-control.mjs start",
    "server:https:status": "HTTPS=1 PORT=5174 TLS_CERT=target/server/ip-cert.pem TLS_KEY=target/server/ip-key.pem node tools/server-control.mjs status",
    "server:https:stop": "HTTPS=1 PORT=5174 TLS_CERT=target/server/ip-cert.pem TLS_KEY=target/server/ip-key.pem node tools/server-control.mjs stop",
    "server:https:restart": "HTTPS=1 PORT=5174 TLS_CERT=target/server/ip-cert.pem TLS_KEY=target/server/ip-key.pem node tools/server-control.mjs restart",
    "workflow:status": "node tools/workflow-assistant.mjs status",
    "workflow:review": "node tools/workflow-assistant.mjs review",
    "ludo:api": "node tools/ludo-api.mjs",
    "build:walkmasks": "node tools/build-walk-masks.js",
    "build:object-geometry": "node tools/build-scene-object-geometry.js",
    "build:scene-layers": "node tools/build-scene-layers.js",
    "build:scene-layer-runtime": "node tools/build-scene-layer-runtime.js",
    "build:runtime-animations": "node tools/build-external-runtime-staging.js && node tools/optimize-external-runtime-assets.mjs",
    "build:runtime-assets": "node tools/build-runtime-asset-manifest.mjs",
    "build:runtime": "npm run build:runtime-animations && npm run build:runtime-assets && npm run build:animation-catalogs",
    "build:bai-mitko-animation-catalog": "node tools/build-animation-catalog.mjs",
    "build:animation-catalog": "npm run build:animation-catalogs",
    "build:animation-catalogs": "npm run build:bai-mitko-animation-catalog && node tools/build-animation-library.mjs",
    "check:animation-catalog": "node tools/build-animation-catalog.mjs --check && node tools/build-animation-library.mjs --check",
    "check:animation-catalogs": "npm run check:animation-catalog",
    "fit:action": "node tools/register-external-action.mjs",
    "verify:action-render": "node tools/verify-action-render.mjs",
    "test": "node --test --test-concurrency=2 test/*.test.js"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "playwright": "^1.61.1"
  }
}
